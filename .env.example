#
# Copy this file to .env and set values for each server.
# Do not commit the real .env file.
#

# Required: TMDB API key used by movie/tv metadata scripts.
TMDB_API_KEY=your_tmdb_api_key_here

# Media root + ownership (maintenance/fix_media_perms.py).
RC_MEDIA_BASE=/storage/media
RC_MEDIA_OWNER=david
RC_MEDIA_GROUP=media

# Servarr working tree: stage dirs, logs, nfo_backups, compare plans.
# Precedence: RC_SERVARR_DIR, else $RC_MEDIA_BASE/servarr, else /storage/media/servarr.
# Scripts never fall back to the current directory.
# RC_SERVARR_DIR=/storage/media/servarr

# Library scanned by verify_movies.py and the audit_* scripts (default $RC_MEDIA_BASE/movies).
# RC_VERIFY_SCAN_DIR=/storage/media/movies

# Custom ffmpeg/ffprobe binaries (leave commented to use PATH).
# RC_FFMPEG_BIN=/usr/bin/ffmpeg
# RC_FFPROBE_BIN=/usr/bin/ffprobe

# Radarr (maintenance/radarr_upgrade_push.py). Each site (192.168.33.x and
# 192.168.36.x) runs its own Radarr; the script uses the block for the subnet
# it is running on, detected from the host's IPs. RC_SITE=33|36 overrides
# that detection only when it fails. Profile 7 ("Mine") and the root folder
# are identical on both instances (verified 2026-10-16).
# RC_SITE=
RADARR_URL_33=http://192.168.33.195:7878
RADARR_API_KEY_33=your_radarr_api_key_here
RADARR_PROFILE_ID_33=7
RADARR_ROOT_FOLDER_33=/servarr/servarr/movies
RADARR_URL_36=http://192.168.36.195:7878
RADARR_API_KEY_36=your_radarr_api_key_here
RADARR_PROFILE_ID_36=7
RADARR_ROOT_FOLDER_36=/servarr/servarr/movies

# Jellyfin API (Dashboard -> API Keys). Not read by any script; used for
# interactive Jellyfin management (metadata cleanup, refreshes, collections).
# One server per site; each key is valid only on its own server.
JELLYFIN_URL_33=http://192.168.33.200:8096
JELLYFIN_API_KEY_33=your_jellyfin_api_key_here
JELLYFIN_URL_36=http://192.168.36.200:8096
JELLYFIN_API_KEY_36=your_jellyfin_api_key_here

# OpenSubtitles (foreign_cleanup subtitle search/fetch).
OPENSUB_API_KEY=your_opensubtitles_api_key_here

# Lidarr (music_cleanup/music_cleaner.py): unmonitor published albums.
# Same per-site rule as Radarr. Only the .33 site runs Lidarr today; leave the
# _36 pair empty and the handoff logs a [WARN] and skips on that site.
LIDARR_URL_33=http://192.168.33.195:8686
LIDARR_API_KEY_33=your_lidarr_api_key_here
LIDARR_URL_36=
LIDARR_API_KEY_36=
