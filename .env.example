#
# Copy this file to .env and set values for each server.
# Do not commit the real .env file.
#

# Required: TMDB API key used by movie/tv metadata scripts.
TMDB_API_KEY=your_tmdb_api_key_here

# Media root + ownership (maintenance/fix_media_perms.py).
RC_MEDIA_BASE=/storage/media
RC_MEDIA_OWNER=david
RC_MEDIA_GROUP=media

# Servarr working tree: stage dirs, logs, nfo_backups, compare plans.
# Precedence: RC_SERVARR_DIR, else $RC_MEDIA_BASE/servarr, else /storage/media/servarr.
# Scripts never fall back to the current directory.
# RC_SERVARR_DIR=/storage/media/servarr

# Library scanned by verify_movies.py / audit_decode_integrity.py.
RC_VERIFY_SCAN_DIR=/storage/media/movies

# Custom ffmpeg/ffprobe binaries (leave commented to use PATH).
# RC_FFMPEG_BIN=/usr/bin/ffmpeg
# RC_FFPROBE_BIN=/usr/bin/ffprobe

# Radarr (maintenance/radarr_upgrade_push.py).
RADARR_URL=http://192.168.36.195:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_PROFILE_ID=7                       # "Mine"
RADARR_ROOT_FOLDER=/servarr/servarr/movies

# OpenSubtitles (foreign_cleanup subtitle search/fetch).
OPENSUB_API_KEY=your_opensubtitles_api_key_here

# Lidarr (music_cleanup/music_cleaner.py): unmonitor published albums.
LIDARR_URL=http://192.168.33.195:8686
LIDARR_API_KEY=your_lidarr_api_key_here
