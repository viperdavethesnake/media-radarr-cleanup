#
# Copy this file to .env and set values for each server.
# Do not commit the real .env file.
#

# Required: TMDB API key used by movie/tv metadata scripts.
TMDB_API_KEY=your_tmdb_api_key_here

# Radarr integration (maintenance/radarr_upgrade_push.py).
# URL + API key are required for Radarr pushes; profile/root have sane defaults.
RADARR_URL=http://192.168.36.195:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_PROFILE_ID=7                       # "Mine"
RADARR_ROOT_FOLDER=/servarr/servarr/movies

# Jellyfin API (Dashboard -> API Keys)
JELLYFIN_URL=http://192.168.36.200:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# OpenSubtitles API (foreign_cleanup subtitle search/fetch)
OPENSUB_API_KEY=your_opensubtitles_api_key_here

# Optional: media root + ownership for maintenance/fix_media_perms.py
RC_MEDIA_BASE=/storage/media
RC_MEDIA_OWNER=david
RC_MEDIA_GROUP=media

# Optional: servarr working tree (stage dirs, logs, nfo_backups, compare plans).
# Precedence: RC_SERVARR_DIR, else $RC_MEDIA_BASE/servarr, else /storage/media/servarr.
# Scripts never fall back to the current directory.
# RC_SERVARR_DIR=/storage/media/servarr

# Optional: movie cleanup path overrides (defaults derive from RC_SERVARR_DIR)
RC_VERIFY_SCAN_DIR=/storage/media/movies
# RC_FOREIGN_DIR=/storage/media/servarr/foreign
# RC_CLEANED_DIR=/storage/media/servarr/cleaned

# Optional: analyzer path overrides
RC_MOVIES_DIR=/storage/media/servarr/cleaned
RC_WORK_DIR=/space/media/working
RC_OUTPUT_DIR=/space/media/av1

# Optional: custom ffmpeg/vmaf overrides (leave blank to use PATH defaults)
# RC_FFMPEG_PREFIX=/home/david/git/radarr_cleanup/ffmpeg-build
# RC_VMAF_LIB_DIR=/home/david/git/radarr_cleanup/vmaf-install/lib/x86_64-linux-gnu
# RC_FFMPEG_BIN=/usr/bin/ffmpeg
# RC_FFPROBE_BIN=/usr/bin/ffprobe
# RC_LD_LIBRARY_PATH=/custom/lib/path

# Lidarr integration (music_cleanup/music_cleaner.py): unmonitor published albums.
LIDARR_URL=http://192.168.33.195:8686
LIDARR_API_KEY=your_lidarr_api_key_here
